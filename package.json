{
  "name": "omniscout-research-radar",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Werkend lokaal scoutingprototype met expliciete datadekking, bewijs en onderzoeksacties.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/browser-e2e.mjs",
    "check": "node tools/check.mjs",
    "preview:build": "node tools/build-preview.mjs",
    "verify": "npm run check && npm test && npm run preview:build",
    "test:accounts": "node tools/browser-accounts.mjs",
    "test:offline": "node tools/offline-smoke.mjs",
    "test:cli": "node tools/cli-smoke.mjs",
    "test:recovery": "node tools/browser-recovery.mjs",
    "backup:server": "node tools/server-backup.mjs",
    "test:profiles": "node tools/browser-public-profiles.mjs",
    "profiles:fetch": "node tools/fetch-public-profiles.mjs",
    "profiles:preview": "node tools/build-public-profiles.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
